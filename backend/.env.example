# Render proporciona PORT automaticamente.
PORT=5000

# Cadena de conexion de MongoDB Atlas, incluido el nombre de la base de datos.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database

# URL publica del frontend incluida en las notificaciones por correo.
FRONTEND_URL=https://pedidos.esteling.com

# Aplicacion Microsoft Entra ID usada para autenticar usuarios de la plataforma.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Credenciales de la aplicacion confidencial usadas exclusivamente para Business Central.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret
BC_SCOPE=https://api.businesscentral.dynamics.com/.default
BC_API_URL=https://api.businesscentral.dynamics.com/v2.0/tenant/environment/api/publisher/group/version/entity

# Aplicacion confidencial de Entra ID usada exclusivamente para Microsoft Graph.
# Requiere el permiso de aplicacion Mail.Send con consentimiento de administrador.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-graph-client-secret

# Buzon de Microsoft 365/Exchange Online desde el que Microsoft Graph enviara el correo.
GRAPH_SENDER_EMAIL=notifications@esteling.com


# Solo es necesaria si frontend y backend se despliegan por separado.
REACT_APP_API_URL=

# Registro de aplicacion SPA de Microsoft Entra ID.
REACT_APP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# El callback siempre es el dominio actual + /redirect. Registrarlo como SPA en Entra.

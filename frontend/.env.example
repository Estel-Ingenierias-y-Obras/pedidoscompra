# URL publica del servicio backend desplegado en Render, sin barra final.
REACT_APP_API_URL=https://your-backend.onrender.com

# Registro de aplicacion SPA de Microsoft Entra ID.
REACT_APP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Debe coincidir exactamente con la Redirect URI registrada en Entra ID.
REACT_APP_ENTRA_REDIRECT_URI=https://your-site.netlify.app/redirect
